---
import { Image } from "astro:assets";
import photo from "../assets/photo.png";
import Entry from "../components/Entry.astro";
import Library from "../components/figures/Library.astro";
import Regions from "../components/figures/Regions.astro";
import SignIn from "../components/figures/SignIn.astro";
import TypeScript from "../components/figures/TypeScript.astro";
import Layout from "../layouts/Layout.astro";

const built = [
  {
    title: "One codebase, three countries",
    detail: "kudy.io, kudy.ng 2024, kudy.us 2025",
    year: "2024",
    figure: Regions,
    story: [
      "Kudy began with one site, kudy.io. I split the codebase so that it builds a separate site for each country: kudy.ng launched in July 2024 and kudy.us in July 2025. One typed list of routes decides which pages, features, sitemap and robots rules each domain gets.",
      "I set up each site on AWS S3 and CloudFront, with certificates from ACM and DNS on Cloudflare, and wrote the runbook the team uses to add the next country. Our designer drew the pages, and the team built many of the sections.",
    ],
  },
  {
    title: "A shared UI library",
    detail: "v1.0 Feb 2024 to v3.6",
    year: "2024",
    figure: Library,
    story: [
      "The investor app and the admin app kept rebuilding the same inputs, buttons and modals. Instead of a large design-system project, I proposed a small published package, and built the first version overnight.",
      "It is now a private package with typed, tree-shakable builds and automatic releases. Both apps use it every day.",
    ],
  },
  {
    title: "Modernising the web app",
    detail: "TypeScript, Vite, Astro, React 19",
    year: "2023 — 2026",
    figure: TypeScript,
    story: [
      "Since 2023 I have moved Kudy's web app, step by step and next to feature work, from JavaScript to TypeScript (2023), from Create React App to Vite (2024), to Tailwind v4 (2025) and to React 19 (2026).",
      "In 2026 I also moved the public pages to Astro, so that they render ahead of time and search engines can read them.",
    ],
  },
  {
    title: "Signing in once, across regions",
    year: "2026",
    figure: SignIn,
    story: [
      "The three sites are on different domains, so they cannot share cookies or storage, and a user who moved between them had to sign in again.",
      "I built both sides of the fix. The API issues a single-use code that expires after 60 seconds. The app passes it in the URL fragment, so it never reaches server logs, and the target site trades it for a session.",
    ],
  },
];

const contract = [
  {
    title: "Turn Up",
    detail: "Nightlife bookings · Flutter, Next.js, Firebase",
    year: "2026",
    story: [
      "I joined this live, invite-only nightlife app in the middle of the build and hardened it across the Flutter app, the Next.js dashboards and Firebase: Stripe Connect payouts, phone sign-in, and the booking and check-in rules.",
    ],
    link: { label: "turnuplive.com", url: "https://turnuplive.com" },
  },
  {
    title: "Eko International Market",
    detail: "Marketplace · Next.js, Firebase, Stripe",
    year: "2026",
    story: [
      "A marketplace that sells Nigerian goods to buyers abroad, with portals for customers, vendors, admins and fulfilment. I built the fulfilment and operations tools: shipment tracking, disputes, admin analytics and exports, stock held during payment, and buyer and vendor messaging.",
    ],
  },
];

const projects = [
  {
    name: "Interview Studio",
    detail: "Interview practice, with progress synced to Google sign-in",
    url: "https://viaxco-interview-studio.netlify.app",
  },
  {
    name: "Gemini File Processor",
    detail: "Batch-processes documents with Gemini and exports to Google Drive",
    url: "https://gemini-file-processor.vercel.app",
  },
  {
    name: "Gemini Image & Audio to Text",
    detail: "OCR and transcription in the browser, exported to Word",
    url: "https://gemini-image-and-audio-to-text.vercel.app",
  },
  {
    name: "MicMuteBar",
    detail: "A macOS menu bar app that truly mutes the mic",
    url: "https://github.com/ViaxCo/MicMuteBar",
  },
];

const clients = [
  {
    name: "ADEK Properties",
    detail: "Site for an Abuja real-estate company",
    url: "https://adekpropertiesandinvestment.com",
  },
  {
    name: "Hadassah Honey Hub",
    detail: "A Nigerian honey brand, with WhatsApp ordering",
    url: "https://hadassahhoneyhub.com.ng",
  },
  {
    name: "Tobey Okafor",
    detail: "Portfolio for a public-health leader, edited through a CMS",
    url: "https://tobey-okafor.netlify.app",
  },
  {
    name: "Church Database",
    detail: "Membership, attendance and giving records · demo with sample data",
    url: "https://church-database-demo.vercel.app",
  },
  {
    name: "Emora SmartMatch",
    detail: "A gift finder for Nigeria that keeps to your budget",
    url: "https://user-waitlist-two.vercel.app",
  },
];

const earlier = [
  { name: "SCOLA school portal", url: "https://viaxco-lms.netlify.app" },
  { name: "Shopping app", url: "https://viaxco-ecommerce-demo.netlify.app" },
  { name: "Quiz", url: "https://viaxco-quiz.netlify.app" },
  {
    name: "Expense tracker",
    url: "https://viaxco-expense-tracker.onrender.com",
  },
  { name: "Todo list", url: "https://viaxco-todolist-v4-next.vercel.app" },
  { name: "News app", url: "https://github.com/ViaxCo/news-app" },
];

const elsewhere = [
  { name: "Email", url: "mailto:ajibadevic@gmail.com" },
  { name: "GitHub", url: "https://github.com/ViaxCo" },
  { name: "LinkedIn", url: "https://www.linkedin.com/in/victor-ajibade/" },
];
---

<Layout>
  <main class="mx-auto max-w-[42rem] px-6 pt-9 pb-24 min-[480px]:px-[39px] text-[13.5px] leading-[1.3] tracking-[-0.01em] sm:pt-20 sm:text-[14.5px]">
    <header class="flex items-start justify-between gap-6">
      <div class="pt-5">
        <h1 class="text-[18.5px] leading-snug font-medium sm:text-[19.5px]">
          Victor Ajibade
        </h1>
        <p class="text-[16.5px] leading-snug text-mute sm:text-[17px]">
          Software engineer
        </p>
      </div>
      <Image
        src={photo}
        alt="Victor Ajibade"
        width={160}
        height={160}
        loading="eager"
        class="size-20 shrink-0 rounded-full object-cover"
      />
    </header>

    <p class="mt-7 text-[17.5px] leading-[1.3] text-pretty sm:text-[20px]">
      I build the systems behind products: one codebase for three countries, a
      shared UI library, and long, careful upgrades.
    </p>

    <div class="mt-7 grid gap-y-5">
      <section class="row">
        <h2>Now</h2>
        <div>
          <p>
            <a href="https://kudy.io" class="link">
              Kudy Financials
            </a>{" "}
            · 2023 — now
          </p>
          <p class="mt-1 max-w-[34rem] text-mute">
            Frontend engineer, with backend work since 2026. I review most
            frontend changes, run releases and mentor the other frontend
            engineers.
          </p>
        </div>
      </section>

      <section class="row">
        <h2>Built</h2>
        <ul class="grid gap-y-3">
          {built.map((item) => (
            <li>
              <Entry {...item} />
            </li>
          ))}
        </ul>
      </section>

      <section class="row">
        <h2>Contract</h2>
        <ul class="grid gap-y-3">
          {contract.map((item) => (
            <li>
              <Entry {...item} />
            </li>
          ))}
        </ul>
      </section>

      {[
        { label: "Projects", items: projects },
        { label: "Clients", items: clients },
      ].map(({ label, items }) => (
        <section class="row">
          <h2>{label}</h2>
          <ul class="grid gap-y-3">
            {items.map((item) => (
              <li>
                <a
                  href={item.url}
                  class="link inline-flex items-center gap-1.5"
                >
                  {item.name}
                  <svg viewBox="0 0 12 12" class="arrow" aria-hidden="true">
                    <path d="M3.5 8.5l5-5M4.5 3.5h4v4" />
                  </svg>
                </a>
                <span class="block text-mute">{item.detail}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <section class="row">
        <h2>Earlier</h2>
        <p class="leading-[1.6]">
          {earlier.map((item, i) => (
            <>
              <a href={item.url} class="link whitespace-nowrap">
                {item.name}
              </a>
              {i < earlier.length - 1 && <span class="text-mute">, </span>}
            </>
          ))}
          <span class="block text-mute">
            2021, from my first year in software
          </span>
        </p>
      </section>

      <section class="row">
        <h2>About</h2>
        <p class="max-w-[34rem] leading-[1.6] text-mute">
          I studied electrical and electronics engineering at Landmark
          University and graduated with first-class honours. I planned power
          systems at the Transmission Company of Nigeria, then moved to software
          in 2021.
        </p>
      </section>

      <section class="row">
        <h2>Elsewhere</h2>
        <ul class="leading-[1.6]">
          {elsewhere.map((link) => (
            <li>
              <a href={link.url} class="link">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="row">
        <h2>Based</h2>
        <p>Abuja, working remotely · Open to select freelance work</p>
      </section>
    </div>
  </main>
</Layout>

<style>
  @reference "../styles/global.css";

  .row {
    --label: 5.5rem;
    display: grid;
    grid-template-columns: var(--label) 1fr;
  }

  @media (width >= 480px) {
    .row {
      --label: 6.5rem;
    }
  }

  @media (width >= 40rem) {
    .row {
      --label: 8rem;
    }
  }

  .row > h2 {
    @apply text-mute;
  }

  .link {
    @apply hover:decoration-mute underline decoration-transparent transition-colors duration-200;
  }

  .arrow {
    @apply stroke-mute size-3 shrink-0 fill-none transition-transform duration-200 ease-out;
    stroke-width: 1.2;
  }

  .link:hover .arrow {
    transform: translate(1px, -1px);
  }
</style>
