---
import { Image } from "astro:assets";
import photo from "../assets/photo.png";
import Entry from "../components/Entry.astro";
import Branches from "../components/figures/Branches.astro";
import TypeScript from "../components/figures/TypeScript.astro";
import Layout from "../layouts/Layout.astro";

const built = [
  {
    title: "One codebase for three countries",
    detail: "Kudy's sites for Nigeria, the US and the rest of the world",
    figure: Branches,
    figureProps: {
      source: "one codebase",
      targets: [
        { label: "kudy.io" },
        { label: "kudy.ng", note: "2024" },
        { label: "kudy.us", note: "2025" },
      ],
    },
    story: [
      "Kudy began with one site, kudy.io. I split the codebase so that it builds a separate site for each country: kudy.ng went live in 2024 and kudy.us in 2025. I also made it possible to move between the sites without signing in again.",
      "I set up each site on AWS S3 and CloudFront, with certificates from ACM and DNS on Cloudflare, and wrote the runbook the team uses to add the next country. Our designer drew the pages, and the team built many of the sections.",
    ],
  },
  {
    title: "A shared UI library",
    detail: "One set of components for two apps",
    figure: Branches,
    figureProps: {
      source: "shared UI library",
      targets: [{ label: "web app" }, { label: "admin app" }],
    },
    story: [
      "Kudy's web app and its internal admin app kept rebuilding the same inputs, buttons and modals. Instead of a large design-system project, I proposed a small shared package and built the first version overnight in February 2024.",
      "It is now a private package with typed builds and automatic releases, and both apps use it every day.",
    ],
  },
  {
    title: "Bringing the web app up to date",
    detail: "TypeScript, faster builds and a newer React",
    figure: TypeScript,
    story: [
      "Since 2023 I have moved Kudy's web app from JavaScript to TypeScript, from Create React App to Vite, to Tailwind v4 and to React 19, a piece at a time while we kept shipping features.",
      "In 2026 I also moved the public pages to Astro, so that they render ahead of time and search engines can read them.",
    ],
  },
];

const contract = [
  {
    title: "Turn Up",
    detail: "Nightlife booking app · Flutter, Next.js, Firebase",
    story: [
      "In 2026 I took over development of the live app. I fixed and built on its payments to venues, phone sign-in, and the rules for bookings and check-in, across the Flutter app, the web dashboards and Firebase.",
    ],
    link: { label: "turnuplive.com", url: "https://turnuplive.com" },
  },
  {
    title: "Eko International Market",
    detail: "Marketplace · Next.js, Firebase, Stripe",
    story: [
      "A marketplace that sells Nigerian goods to buyers abroad. In 2026 I built its fulfilment and operations tools: shipment tracking, disputes, admin analytics and exports, stock held during payment, and messaging between buyers and vendors.",
    ],
    link: {
      label: "ekointernationalmarket.com",
      url: "https://ekointernationalmarket.com",
    },
  },
];

const automation = [
  {
    title: "Automations with n8n",
    detail: "Self-hosted on my own server, with AI agents and Telegram",
    story: [
      "Since 2025 I have run my own n8n on a VPS I set up with Docker. The biggest workflow runs my church's weekly reports over WhatsApp and Telegram.",
      "Other workflows turn YouTube videos into to-do items, answer questions about documents in Telegram, and watch a CI pipeline for failures. On the same server I run Hermes, an open-source AI agent, and I talk to it through Telegram by text or voice.",
    ],
  },
];

const external = { target: "_blank", rel: "noreferrer" };

const projects = [
  {
    name: "Gemini File Processor",
    detail:
      "My pastor's teachings existed only as recordings. I transcribed over 3,000 of them with MacWhisper, then this app cleaned up each transcript and saved it to Google Drive.",
    url: "https://gemini-file-processor.vercel.app",
    proof: {
      label: "See the transcripts",
      url: "https://drive.google.com/drive/folders/1FcVJuxyvzeR4SAv894fVE4yZekJFAfq4",
    },
  },
  {
    name: "Gemini Image & Audio to Text",
    detail:
      "I photograph whole books, and this app turns the pages into text I can edit.",
    url: "https://gemini-image-and-audio-to-text.vercel.app",
  },
  {
    name: "WhatsApp unread counter",
    detail: "Shows how many WhatsApp chats are unread, right in the menu bar.",
  },
  {
    name: "MicMuteBar",
    detail:
      "Mic Drop costs money, so I built my own way to mute my mic from the menu bar, whatever app I'm in.",
    url: "https://github.com/ViaxCo/MicMuteBar",
  },
  {
    name: "ActiveTimeBar",
    detail:
      "Shows in the menu bar how long I've been at my computer today. It reads the data from ActivityWatch.",
  },
  {
    name: "Spotify Notifications",
    detail:
      "Spotify on Mac doesn't tell you when the song changes, so I built a Chrome extension that does.",
    url: "https://chromewebstore.google.com/detail/spotify-notifications/bafpmlbnkbemofddicmfkaigjnicdmcl",
  },
  {
    name: "Interview Studio",
    detail: "Interview practice I built for a friend who was job hunting.",
    url: "https://viaxco-interview-studio.netlify.app",
  },
];

const clients = [
  {
    name: "ADEK Properties",
    detail: "Site for an Abuja real-estate company",
    url: "https://adekpropertiesandinvestment.com",
  },
  {
    name: "Hadassah Honey Hub",
    detail: "A Nigerian honey brand, with WhatsApp ordering",
    url: "https://hadassahhoneyhub.com.ng",
  },
  {
    name: "Tobey Okafor",
    detail: "Portfolio for a public-health leader, edited through a CMS",
    url: "https://tobey-okafor.netlify.app",
  },
  {
    name: "Church Database",
    detail: "Membership, attendance and giving records · demo with sample data",
    url: "https://church-database-demo.vercel.app",
  },
  {
    name: "Emora SmartMatch",
    detail: "A gift finder for Nigeria that keeps to your budget",
    url: "https://emora.com.ng",
  },
];

const earlier = [
  { name: "SCOLA school portal", url: "https://viaxco-lms.netlify.app" },
  { name: "Shopping app", url: "https://viaxco-ecommerce-demo.netlify.app" },
];

const elsewhere = [
  { name: "Email", url: "mailto:ajibadevic@gmail.com" },
  { name: "GitHub", url: "https://github.com/ViaxCo" },
  { name: "LinkedIn", url: "https://www.linkedin.com/in/victor-ajibade/" },
];
---

<Layout>
  <main class="mx-auto max-w-[42rem] px-6 pt-9 pb-24 min-[480px]:px-[39px] text-[13.5px] leading-[1.3] tracking-[-0.01em] sm:pt-20 sm:text-[14.5px]">
    <header class="flex items-start justify-between gap-6">
      <div class="pt-5">
        <h1 class="text-[18.5px] leading-snug font-medium sm:text-[19.5px]">
          Victor Ajibade
        </h1>
        <p class="text-[16.5px] leading-snug text-mute sm:text-[17px]">
          Software engineer
        </p>
      </div>
      <Image
        src={photo}
        alt="Victor Ajibade"
        width={160}
        height={160}
        loading="eager"
        class="size-20 shrink-0 rounded-full object-cover"
      />
    </header>

    <p class="mt-7 text-[17.5px] leading-[1.3] text-pretty sm:text-[20px]">
      I build with care and pay close attention to the little details.
    </p>

    <div class="mt-7 grid gap-y-5">
      <section class="row">
        <h2>Now</h2>
        <div>
          <p>
            <a href="https://kudy.io" class="link" {...external}>
              Kudy Financials
            </a>{" "}
            · 2023 — now
          </p>
          <p class="mt-1 max-w-[34rem] text-mute">
            I work across the web app, the admin app and the API. I lead the big
            upgrades, fix production when it breaks, and poke holes in designs
            before users do.
          </p>
        </div>
      </section>

      {[
        { label: "Built", items: built },
        { label: "Contract", items: contract },
        { label: "Automation", items: automation },
      ].map(({ label, items }) => (
        <section class="row">
          <h2>{label}</h2>
          <ul class="grid gap-y-3">
            {items.map((item) => (
              <li>
                <Entry {...item} />
              </li>
            ))}
          </ul>
        </section>
      ))}

      {[
        { label: "Projects", items: projects },
        { label: "Clients", items: clients },
      ].map(({ label, items }) => (
        <section class="row">
          <h2>{label}</h2>
          <ul class="grid gap-y-3">
            {items.map((item) => (
              <li>
                {item.url ? (
                  <a
                    href={item.url}
                    class="link inline-flex items-center gap-1.5"
                    {...external}
                  >
                    {item.name}
                    <svg viewBox="0 0 12 12" class="arrow" aria-hidden="true">
                      <path d="M3.5 8.5l5-5M4.5 3.5h4v4" />
                    </svg>
                  </a>
                ) : (
                  <span>{item.name}</span>
                )}
                <span class="block max-w-[34rem] text-mute">
                  {item.detail}
                  {item.proof && (
                    <>
                      {" "}
                      <a
                        href={item.proof.url}
                        class="link text-ink"
                        {...external}
                      >
                        {item.proof.label}
                      </a>
                    </>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <section class="row">
        <h2>Earlier</h2>
        <p class="leading-[1.6]">
          {earlier.map((item, i) => (
            <>
              <a href={item.url} class="link whitespace-nowrap" {...external}>
                {item.name}
              </a>
              {i < earlier.length - 1 && <span class="text-mute">, </span>}
            </>
          ))}
          <span class="block text-mute">
            2021 · Built at{" "}
            <a href="https://hasob.ng" class="link text-ink" {...external}>
              HASOB
            </a>
          </span>
        </p>
      </section>

      <section class="row">
        <h2>About</h2>
        <p class="max-w-[34rem] leading-[1.6] text-mute">
          I studied electrical and electronics engineering at Landmark
          University and graduated with first-class honours. I planned power
          systems at the Transmission Company of Nigeria, then moved to software
          in 2021, starting as a frontend intern at HASOB.
        </p>
      </section>

      <section class="row">
        <h2>Elsewhere</h2>
        <ul class="leading-[1.6]">
          {elsewhere.map((link) => (
            <li>
              <a
                href={link.url}
                class="link"
                {...(link.url.startsWith("http") ? external : {})}
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="row">
        <h2>Based</h2>
        <p>Abuja, working remotely</p>
      </section>
    </div>
  </main>
</Layout>

<style>
  @reference "../styles/global.css";

  .row {
    --label: 5.5rem;
    display: grid;
    grid-template-columns: var(--label) 1fr;
  }

  @media (width >= 480px) {
    .row {
      --label: 6.5rem;
    }
  }

  @media (width >= 40rem) {
    .row {
      --label: 8rem;
    }
  }

  .row > h2 {
    @apply text-mute;
  }

  .link {
    @apply hover:decoration-mute underline decoration-transparent transition-colors duration-200;
  }

  .arrow {
    @apply stroke-mute size-3 shrink-0 fill-none transition-transform duration-200 ease-out;
    stroke-width: 1.2;
  }

  .link:hover .arrow {
    transform: translate(1px, -1px);
  }
</style>
