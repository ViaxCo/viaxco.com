---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found · Victor Ajibade" noindex>
  <main class="mx-auto max-w-[42rem] px-6 pt-9 pb-24 min-[480px]:px-[39px] sm:pt-20">
    <p class="text-[17.5px] leading-[1.3] sm:text-[20px]">Nothing here.</p>
    <p class="mt-2 text-[14.5px] text-mute">
      This page doesn't exist, or it has moved.
    </p>
    <a
      href="/"
      class="mt-6 inline-block text-[14.5px] underline decoration-mute underline-offset-4 transition-colors duration-200 hover:decoration-ink"
    >
      Back to viaxco.com
    </a>
  </main>
</Layout>
